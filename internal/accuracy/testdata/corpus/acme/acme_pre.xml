<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic presentation linkbase for one statement role. Exercises depth
     nesting, a non-abstract subtotal parent (CostsAndExpenses), totalLabel
     totals on leaf concepts (GrossProfit, OperatingExpenses, NetIncome), and
     abstract grouping nodes that carry no facts (IncomeStatementAbstract). -->
<link:linkbase xmlns:link="http://www.xbrl.org/2003/linkbase" xmlns:xlink="http://www.w3.org/1999/xlink">
  <link:presentationLink xlink:type="extended" xlink:role="http://acme.example/role/StatementsOfIncome">
    <link:loc xlink:type="locator" xlink:label="loc_IncomeStatementAbstract" xlink:href="acme.xsd#acme_IncomeStatementAbstract"/>
    <link:loc xlink:type="locator" xlink:label="loc_Revenues" xlink:href="acme.xsd#acme_Revenues"/>
    <link:loc xlink:type="locator" xlink:label="loc_CostOfSales" xlink:href="acme.xsd#acme_CostOfSales"/>
    <link:loc xlink:type="locator" xlink:label="loc_GrossProfit" xlink:href="acme.xsd#acme_GrossProfit"/>
    <link:loc xlink:type="locator" xlink:label="loc_CostsAndExpenses" xlink:href="acme.xsd#acme_CostsAndExpenses"/>
    <link:loc xlink:type="locator" xlink:label="loc_ResearchExpense" xlink:href="acme.xsd#acme_ResearchExpense"/>
    <link:loc xlink:type="locator" xlink:label="loc_OperatingExpenses" xlink:href="acme.xsd#acme_OperatingExpenses"/>
    <link:loc xlink:type="locator" xlink:label="loc_NetIncome" xlink:href="acme.xsd#acme_NetIncome"/>

    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="1" preferredLabel="http://www.xbrl.org/2003/role/terseLabel" xlink:from="loc_IncomeStatementAbstract" xlink:to="loc_Revenues"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="2" preferredLabel="http://www.xbrl.org/2003/role/terseLabel" xlink:from="loc_IncomeStatementAbstract" xlink:to="loc_CostOfSales"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="3" preferredLabel="http://www.xbrl.org/2003/role/totalLabel" xlink:from="loc_IncomeStatementAbstract" xlink:to="loc_GrossProfit"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="4" preferredLabel="http://www.xbrl.org/2003/role/terseLabel" xlink:from="loc_IncomeStatementAbstract" xlink:to="loc_CostsAndExpenses"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="1" preferredLabel="http://www.xbrl.org/2003/role/terseLabel" xlink:from="loc_CostsAndExpenses" xlink:to="loc_ResearchExpense"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="2" preferredLabel="http://www.xbrl.org/2003/role/totalLabel" xlink:from="loc_CostsAndExpenses" xlink:to="loc_OperatingExpenses"/>
    <link:presentationArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="5" preferredLabel="http://www.xbrl.org/2003/role/totalLabel" xlink:from="loc_IncomeStatementAbstract" xlink:to="loc_NetIncome"/>
  </link:presentationLink>
</link:linkbase>
